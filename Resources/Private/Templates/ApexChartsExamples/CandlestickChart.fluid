<c:apexcharts>		
	<c:apexchart.candlestick id="1" options="data__candlestickChartOptions" >

        <c:marker id="title">Basic Candlestick Chart</c:marker>     
	        		
		<c:data id="labels">
			2017-10-24, 2017-10-25, 2017-10-26, 2017-10-27
		</c:data>
	
		<c:data id="series">		
            <c:item key="0">
                <c:item key="data">
                    <c:item key="0">
                        <c:item key="x" value="{data__labels.0}" />
                        <c:item key="y" values="20, 38, 10, 34" />
                    </c:item>
                    <c:item key="1">
                        <c:item key="x" value="{data__labels.1}" />    
                        <c:item key="y" values="35, 50, 30, 40" />
                    </c:item>
                    <c:item key="2">
                        <c:item key="x" value="{data__labels.2}" />    
                        <c:item key="y" values="33, 44, 28, 31" />
                    </c:item>
                    <c:item key="3">
                        <c:item key="x" value="{data__labels.3}" />               
                        <c:item key="y" values="15, 42, 5, 38" />                                     
                    </c:item>
               </c:item>
            </c:item>
		</c:data>	
		
        <c:data id="candlestickChartOptions" canBeReplaced="true">
            <c:item key="title">
                <c:item key="text" value="{marker__title}" />
            </c:item> 
            <c:item key="xaxis">
                <c:item key="type" value="date" />
            </c:item>           
            <c:item key="series" value="{data__series}" />            
        </c:data>		
		
	</c:apexchart.candlestick>
</c:apexcharts>
