<c:apexcharts>		
	<c:apexchart.funnel id="1" options="data__funnelChartOptions" >

        <c:marker id="title">Basic Funnel Chart</c:marker>     	        	

        <c:data id="labels">
            Sourced,
            Screened,
            Assessed,
            HR Interview,
            Technical,
            Verify,
            Offered,
            Hired
        </c:data>
        
        <c:data id="series">
            <c:item key="0">
                <c:item key="name" value="Funnel Series" />
                <c:item key="data" values="1380, 1100, 990, 880, 740, 548, 330, 200" />
            </c:item>
        </c:data>
		
        <c:data id="funnelChartOptions" canBeReplaced="true">
            <c:item key="title">
                <c:item key="text" value="{marker__title}" />
            </c:item>
            <c:item key="xaxis">
                <c:item key="categories" value="{data__labels}" />
            </c:item> 
            <c:item key="series" value="{data__series}" />           
        </c:data>		
		
	</c:apexchart.funnel>
</c:apexcharts>
