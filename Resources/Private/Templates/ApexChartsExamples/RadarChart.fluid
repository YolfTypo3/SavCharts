<c:apexcharts>		
	<c:apexchart.radar id="1" options="data__radarChartOptions" >

        <c:marker id="title">Basic Radar Chart</c:marker>     	        	
	    
        <c:data id="labels">
            January, February, March, April, May, June
        </c:data>
            	        		
		<c:data id="series">
			<c:item key="0">
                <c:item key="name" value="Revenue ($k)" />			
                <c:item key="data" values="80, 50, 30, 40, 100, 20" />
            </c:item>                               
		</c:data>	
		
        <c:data id="radarChartOptions" canBeReplaced="true">
            <c:item key="title">
                <c:item key="text" value="{marker__title}" />
            </c:item>   
            <c:item key="xaxis">
                <c:item key="categories" value="{data__labels}" />
            </c:item> 
            <c:item key="series" value="{data__series}" />           
        </c:data>		
		
	</c:apexchart.radar>
</c:apexcharts>
