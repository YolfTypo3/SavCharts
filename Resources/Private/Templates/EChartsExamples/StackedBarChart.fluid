<c:echarts>		
	<c:echart.generic id="1" options="data__stackedChartOptions" >

        <c:marker id="title">Basic Stacked Bar Chart</c:marker>     
	        		
		<c:data id="labels">
            January, February, March, April, May, June, July
		</c:data>

        <c:marker id="labelSet0">First dataset</c:marker>
        <c:marker id="labelSet1">Second dataset</c:marker>   
        <c:marker id="labelSet2">Third dataset</c:marker>
	
        <c:data id="dataSet0">
            65, 59, 80, 81, 56, 55, 4
        </c:data>
        
        <c:data id="dataSet1">
            28, 48, 40, 19, 86, 27, 9
        </c:data>       
        
        <c:data id="dataSet2">
            14, 60, 81, 27, 33, 45, 55
        </c:data>  
        
        <c:data id="series">
            <c:item key="0">
                <c:item key="name" value="{marker__labelSet0}" />
                <c:item key="type" value="bar" />
                <c:item key="stack" value="total" />
                <c:item key="data" value="{data__dataSet0}" />
            </c:item>
            <c:item key="1">
                <c:item key="name" value="{marker__labelSet1}" />
                <c:item key="type" value="bar" />
                <c:item key="stack" value="total" />
                <c:item key="data" value="{data__dataSet1}" />
            </c:item>
            <c:item key="2">
                <c:item key="name" value="{marker__labelSet2}" />
                <c:item key="type" value="bar" />
                <c:item key="stack" value="total" />
                <c:item key="data" value="{data__dataSet2}" />
            </c:item>                        
        </c:data> 	
		
        <c:data id="stackedChartOptions" canBeReplaced="true">
            <c:item key="title">
                <c:item key="text" value="{marker__title}" />
            </c:item>
            <c:item key="xAxis">
                <c:item key="type" value="category" />
                <c:item key="data" value="{data__labels}" />
            </c:item>
            <c:item key="yAxis">
                <c:item key="type" value="value" /> 
            </c:item> 
            <c:item key="tooltip">
                <c:item key="trigger" value="item" />
            </c:item>           
            <c:item key="series" value="data__series" />
         
        </c:data>		
		
	</c:echart.generic>
</c:echarts>
