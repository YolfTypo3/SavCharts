<c:echarts>		
	<c:echart.pie id="1" options="data__pieChartOptions" >

        <c:marker id="title">Basic Pie Chart</c:marker>     	        	
        <c:marker id="radiusMin" value="0%" />
        <c:marker id="radiusMax" value="60%" />

	    <c:data id="radius">
	       <c:item key="0" value="{marker__radiusMin}" />
	       <c:item key="1" value="{marker__radiusMax}" />
	    </c:data>
	        		
		<c:data id="series">
			<c:item key="0">
                <c:item key="value" value="1048" />
                <c:item key="name" value="Search Engine" />
            </c:item>
            <c:item key="1">
                <c:item key="value" value="735" />
                <c:item key="name" value="Direct" />
            </c:item>
            <c:item key="2">
                <c:item key="value" value="580" />
                <c:item key="name" value="Email" />
            </c:item>                        
            <c:item key="3">
                <c:item key="value" value="484" />
                <c:item key="name" value="Union Ads" />
            </c:item>
            <c:item key="4">
                <c:item key="value" value="300" />
                <c:item key="name" value="Video Ads" />
            </c:item>                                     
		</c:data>	
		
        <c:data id="pieChartOptions" canBeReplaced="true">
            <c:item key="title">
                <c:item key="text" value="{marker__title}" />
            </c:item>
            <c:item key="tooltip">
                <c:item key="trigger" value="item" />
            </c:item>
            <c:item key="series"> 
                <c:item key="radius" value="{data__radius}" />        
                <c:item key="data" value="{data__series}" /> 
            </c:item>            
        </c:data>		
		
	</c:echart.pie>
</c:echarts>
