<c:spreadsheet  fileName="EXT:sav_charts/Resources/Private/Templates/PlotlyChartsExamples/Surface3D.csv"> 
    <c:worksheet>
        <c:data id="csv" values="{c:cell.range()->c:transpose()}" />
    </c:worksheet>
</c:spreadsheet>

<c:plotlycharts>        
    <c:plotlychart.generic id="1" data="data__genericChartData" layout="data__genericChartLayout" height="500">

        <c:marker id="title">Surface 3D</c:marker>     
    
        <c:data id="dataSets">
            <c:item key="0">
                <c:item key="z" value="{data__csv}" />
                <c:item key="type">surface</c:item>
            </c:item>
        </c:data>   

        <c:data id="genericChartData" values="{data__dataSets}" /> 
        
        <c:data id="genericChartLayout" canBeReplaced="true">
            <c:item key="title">
                <c:item key="text" value="{marker__title}" />
            </c:item>
            <c:item key="margin">
                <c:item key="t" value="40" />
                <c:item key="b" value="10" />
            </c:item>
        </c:data>       
        
    </c:plotlychart.generic>
</c:plotlycharts>
